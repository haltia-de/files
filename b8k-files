"""Файлы: folders and files in large rows.

The row of places under the header (Дом, Документы, Загрузки, Изображения,
Музыка, Видео, a memory card when one is in, Система) jumps there; "←"
goes up a folder. A tap on a folder opens it, a tap on a file opens it in
the program for it: text in Блокнот (b8k-text), pictures here, video and
sound in b8k-vplay, PDF and web pages in Firefox, anything else with the
system's default. A long press offers Копировать, Вырезать, Переименовать
and Удалить (to the trash); «Вставить» puts what was copied or cut into
the folder shown. Hidden files stay hidden until «Скрытые» shows them.
"""
import os
import shutil
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, GObject, Gtk, Pango

sys.path.insert(0, "/usr/local/share/b8k/python")
try:
    import b8k_ui
except ImportError:
    b8k_ui = None

HOME = os.path.expanduser("~")
TEXT = "/usr/local/bin/b8k-text"
PLAYER = "/usr/local/bin/b8k-vplay"
FUZZEL_INI = "/usr/local/share/b8k/fuzzel-ask.ini"
LIST_MAX = 2000

