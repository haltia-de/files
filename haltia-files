# id, as its .desktop file is named, so a desktop or the Haltia shell finds it.
# The file chooser (--portal) has an id of its own: it is no program on the
# panel, and the shell's «✕» on it means Отмена.
GLib.set_prgname(GALLERY_ID if "--gallery" in sys.argv[1:] else
                 "io.github.haltia_de.FileChooser" if "--portal" in sys.argv[1:] else FILES_ID)

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
