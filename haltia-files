from haltia_kit.settings import Settings  # noqa: E402
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402,F811

# library, media and gallery: next to this file in a checkout, else installed.
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE if os.path.exists(os.path.join(HERE, "media.py"))
                else os.path.join(os.path.dirname(HERE), "lib", "haltia-files"))
import library  # noqa: E402
import media  # noqa: E402

HOME = os.path.expanduser("~")
TEXT = shutil.which("haltia-text") or shutil.which("b8k-text") or "/usr/bin/haltia-text"
# The video window (Видео's haltia-vplay, b8k-vplay before 2.0), wherever it
# is installed; mpv else.
PLAYER = (shutil.which("haltia-vplay") or shutil.which("b8k-vplay") or shutil.which("mpv")
          or "/usr/bin/haltia-vplay")
LIST_MAX = 2000
# Until 3.0: the cache from before the rename moves (ADR 0004).
paths.migrate_dirs("b8k-files", "haltia-files")
CACHE = os.path.join(GLib.get_user_cache_dir(), "haltia-files")

