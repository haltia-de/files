# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-files
pkgver=2.0.2
pkgrel=0
pkgdesc="Files and Gallery: folders, photos, video and music (GTK 3)"
url="https://github.com/haltia-de/files"
arch="noarch"
# The name before ADR 0004: apk upgrade carries b8k-files over to this.
provides="b8k-files=$pkgver-r$pkgrel"
replaces="b8k-files"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 py3-haltia-kit"
checkdepends="gdk-pixbuf"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/files/archive/v$pkgver.tar.gz"
builddir="$srcdir/files-$pkgver"

check() {
	python3 tests/test_library.py
}

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
