pkgname=b8k-files
pkgver=1.4.1
pkgrel=0
pkgdesc="Files and Gallery: folders, photos, video and music in large type (GTK 3)"
url="https://github.com/trudenboy/b8k-files"
arch="noarch"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 py3-b8k-compat"
checkdepends="gdk-pixbuf"
source="$pkgname-$pkgver.tar.gz::https://github.com/trudenboy/b8k-files/archive/v$pkgver.tar.gz"

check() {
	python3 tests/test_library.py
}

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
